[
  {
    "type": "function",
    "function": {
      "name": "execute_actions",
      "description": "Submit exactly ONE tool call in this reply, with one ordered sketch in the actions JSON array. Put all actions of this sketch in that array; do not repeat the call or mix it with other tool calls. Each move contains an ordered selection.waypoints array of complete pose objects. Execute actions and waypoints sequentially, preserve the completed prefix and stop the unexecuted suffix on failure. Return actual observations after the sketch or an early failure so the same agent can plan its next segment.",
      "parameters": {
        "type": "object",
        "properties": {
          "source_step": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional echo of the physical snapshot at request send. Omit to use that exact snapshot; a conflicting value is rejected."
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "description": "Optional batch-purpose note. Action intents remain required; omission does not invent a model statement."
          },
          "visible_evidence": {
            "type": "string",
            "minLength": 1
          },
          "task_context_update": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2400,
            "description": "Optional short implementation/dependency note. Replaces only the previous note, never task_referents. Geometric fit and route estimates belong here, not as evidence of task-part identity."
          },
          "task_referents": {
            "type": "array",
            "maxItems": 8,
            "description": "Optional updates of task-part interpretations, keyed by object_id and a verbatim original-task phrase. Retained independently of route notes. Omit unchanged entries; do not solve unrelated future parts now.",
            "items": {
              "type": "object",
              "properties": {
                "object_id": {
                  "enum": [
                    "book",
                    "caddy"
                  ]
                },
                "task_phrase": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "status": {
                  "enum": [
                    "selected",
                    "unresolved"
                  ]
                },
                "interpretation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "image_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 4
                },
                "revision_basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "required": [
                "object_id",
                "task_phrase",
                "status"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "selected"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "interpretation",
                      "image_paths"
                    ]
                  }
                }
              ]
            }
          },
          "held_object_id": {
            "anyOf": [
              {
                "enum": [
                  "book",
                  "caddy"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "held_pose_relation": {
            "enum": [
              "unchanged",
              "changed",
              "unknown",
              "none"
            ]
          },
          "changed_objects": {
            "type": "array",
            "items": {
              "enum": [
                "book",
                "caddy"
              ]
            },
            "uniqueItems": true,
            "description": "Objects already observed to have changed position/contact. Not the objects you plan to move. Their previous world-point evidence becomes stale even when the proposed action is rejected."
          },
          "actions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "move"
                    },
                    "target_id": {
                      "enum": [
                        "book",
                        "caddy"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "waypoints": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "anchor": {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "enum": [
                                      "current_eef",
                                      "cloud_point",
                                      "image_point"
                                    ]
                                  },
                                  "view_id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "group_id": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "observation_id": {
                                    "type": "string"
                                  },
                                  "camera": {
                                    "enum": [
                                      "agentview",
                                      "robot0_eye_in_hand"
                                    ]
                                  },
                                  "pixel_xy": {
                                    "type": "array",
                                    "items": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 1023
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                  }
                                },
                                "required": [
                                  "kind"
                                ],
                                "additionalProperties": false,
                                "description": "Observed surface point, resolved exactly from the saved pixel table at execution; do not estimate its XYZ. current_eef uses the actual EEF at each waypoint entry; ordinary relative EEF translations pair current_eef with reference=eef."
                              },
                              "reference": {
                                "enum": [
                                  "eef",
                                  "pad_0",
                                  "pad_1",
                                  "pad_midpoint",
                                  "held_bottom",
                                  "held_center"
                                ],
                                "description": "Point placed at anchor+offset: eef = grip_site origin; pad_midpoint = midpoint between the two calibrated finger-pad centres; pad_0/pad_1 = one pad centre. Program handles the entire reference-to-EEF compensation at the requested orientation. Do not add that compensation again to offset_m. Point to align with anchor+offset. held_center is the world-axis AABB centre of the associated observed carried points after applying the TARGET orientation; held_bottom uses that same XY centre and min Z, not a single lowest point with unknown XY. The program compensates the EEF offset. These are observed-shape references, not complete object geometry."
                              },
                              "offset_m": {
                                "type": "array",
                                "items": {
                                  "type": "number"
                                },
                                "minItems": 3,
                                "maxItems": 3,
                                "description": "Desired displacement in metres from the observed anchor to the chosen reference point, not to EEF unless reference=eef."
                              },
                              "offset_frame": {
                                "enum": [
                                  "world",
                                  "tool"
                                ],
                                "description": "world uses world XYZ; tool uses the TARGET tool axes, not the current axes."
                              },
                              "orientation": {
                                "anyOf": [
                                  {
                                    "const": "preserve"
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "rpy_world_rad": {
                                        "type": "array",
                                        "items": {
                                          "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3
                                      }
                                    },
                                    "required": [
                                      "rpy_world_rad"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "rpy_delta_tool_rad": {
                                        "type": "array",
                                        "items": {
                                          "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3
                                      }
                                    },
                                    "required": [
                                      "rpy_delta_tool_rad"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "finger_direction": {
                                        "type": "array",
                                        "items": {
                                          "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3
                                      },
                                      "closing_axis": {
                                        "type": "array",
                                        "items": {
                                          "type": "number"
                                        },
                                        "minItems": 3,
                                        "maxItems": 3
                                      }
                                    },
                                    "required": [
                                      "finger_direction",
                                      "closing_axis"
                                    ],
                                    "additionalProperties": false
                                  }
                                ],
                                "description": "finger_direction = target tool +Z in world, closing_axis = target tool +X in world. Program computes the full quaternion. preserve retains all current axes."
                              }
                            },
                            "required": [
                              "anchor",
                              "reference",
                              "offset_m",
                              "offset_frame",
                              "orientation"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1,
                          "maxItems": 6,
                          "description": "Ordered full-pose waypoints of this move. Gripper changes are separate actions in the enclosing sketch."
                        }
                      },
                      "required": [
                        "waypoints"
                      ],
                      "additionalProperties": false
                    },
                    "reference_target_id": {
                      "enum": [
                        "book",
                        "caddy",
                        "stage_support"
                      ],
                      "description": "Owner of the observed anchor. May be omitted only when all move points are cloud_point views of one known object; the program then uses that registered owner. Native pixels, relative EEF moves and rotations require an explicit reference."
                    }
                  },
                  "required": [
                    "primitive",
                    "target_id",
                    "intent",
                    "selection"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "rotate_roll"
                    },
                    "target_id": {
                      "enum": [
                        "book",
                        "caddy"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "angle_rad": {
                          "type": "number"
                        },
                        "settle_steps": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "angle_rad"
                      ],
                      "additionalProperties": false
                    },
                    "reference_target_id": {
                      "enum": [
                        "book",
                        "caddy",
                        "stage_support"
                      ],
                      "description": "Owner of the observed anchor. May be omitted only when all move points are cloud_point views of one known object; the program then uses that registered owner. Native pixels, relative EEF moves and rotations require an explicit reference."
                    }
                  },
                  "required": [
                    "primitive",
                    "target_id",
                    "intent",
                    "selection",
                    "reference_target_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "rotate_pitch"
                    },
                    "target_id": {
                      "enum": [
                        "book",
                        "caddy"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "angle_rad": {
                          "type": "number"
                        },
                        "settle_steps": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "angle_rad"
                      ],
                      "additionalProperties": false
                    },
                    "reference_target_id": {
                      "enum": [
                        "book",
                        "caddy",
                        "stage_support"
                      ],
                      "description": "Owner of the observed anchor. May be omitted only when all move points are cloud_point views of one known object; the program then uses that registered owner. Native pixels, relative EEF moves and rotations require an explicit reference."
                    }
                  },
                  "required": [
                    "primitive",
                    "target_id",
                    "intent",
                    "selection",
                    "reference_target_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "rotate_yaw"
                    },
                    "target_id": {
                      "enum": [
                        "book",
                        "caddy"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "angle_rad": {
                          "type": "number"
                        },
                        "settle_steps": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "angle_rad"
                      ],
                      "additionalProperties": false
                    },
                    "reference_target_id": {
                      "enum": [
                        "book",
                        "caddy",
                        "stage_support"
                      ],
                      "description": "Owner of the observed anchor. May be omitted only when all move points are cloud_point views of one known object; the program then uses that registered owner. Native pixels, relative EEF moves and rotations require an explicit reference."
                    }
                  },
                  "required": [
                    "primitive",
                    "target_id",
                    "intent",
                    "selection",
                    "reference_target_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "set_gripper"
                    },
                    "target_id": {
                      "anyOf": [
                        {
                          "enum": [
                            "book",
                            "caddy"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Object whose grasp/contact is intentionally changed. Use null when only changing the gripper configuration without a new object target. This does not certify an empty hand; any existing carried reference is still retired."
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "command": {
                          "enum": [
                            "open",
                            "close"
                          ]
                        },
                        "steps": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "command"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "primitive",
                    "target_id",
                    "intent",
                    "selection"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "primitive": {
                      "const": "wait"
                    },
                    "target_id": {
                      "enum": [
                        "book",
                        "caddy"
                      ]
                    },
                    "intent": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selection": {
                      "type": "object",
                      "properties": {
                        "steps": {
                          "type": "integer",
                          "minimum": 1,
